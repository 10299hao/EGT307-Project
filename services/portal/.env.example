PORTAL_DATABASE_PATH=data/portal.db
PORTAL_STATIC_DIR=frontend/dist
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS=false
SEED_DEMO_DATA=true
INCIDENT_STREAM=IncidentStream
INCIDENT_STREAM_ALIASES=incidents
ACTION_RESULT_STREAM=action-results
ACTION_REQUEST_STREAM=ActionStream
ACTION_REQUEST_FIELD=command
ENABLE_EXECUTOR=false
DEAD_LETTER_STREAM=portal-dead-letter
COLLECTOR_OUTPUT_STREAM=log-events
COLLECTOR_MESSAGE_FIELD=data
ANALYZER_INPUT_STREAM=LogStream
ANALYZER_MESSAGE_FIELD=payload
COLLECTOR_HEALTH_URL=http://collector:8080/health
BRIDGE_HEARTBEAT_KEY=portal-integration-bridge:heartbeat
PORTAL_CONSUMER_GROUP=incident-portal
PORTAL_CONSUMER_NAME=portal-1
# Receiver runs on Windows while the Portal runs inside Docker.
LOCAL_NOTIFICATION_URL=http://host.docker.internal:8090/notify
NOTIFICATION_TIMEOUT_SECONDS=4
NOTIFICATION_MAX_ATTEMPTS=3
